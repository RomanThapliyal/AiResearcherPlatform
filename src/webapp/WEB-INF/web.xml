<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>AI Research and Development Platform</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!--
        All servlets in this project use @WebServlet annotations for their URL
        mappings, so no <servlet>/<servlet-mapping> entries are required here.
        This file only needs to exist so Tomcat recognizes this as a valid
        web application and to set the welcome file + session timeout above.
    -->

</web-app>
